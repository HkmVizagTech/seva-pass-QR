# Server port
PORT=4000

# JWT signing secret — use a strong random string in production
JWT_SECRET=change-me-to-a-long-random-string

# MongoDB connection string (MongoDB Atlas)
# Get yours: Atlas > Database > Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/seva_pass?retryWrites=true&w=majority

# Optional fallback: a "direct" connection string (host:port list + replicaSet).
# Use this if the app logs "SRV lookup failed on this machine" (Node's SRV DNS
# resolution can fail on some Windows/machine setups). Find the shard hostnames
# via:  Resolve-DnsName _mongodb._tcp.<cluster>.mongodb.net -Type SRV
# and the replicaSet via:  Resolve-DnsName _mongodb._tcp.<cluster>.mongodb.net -Type TXT
# MONGODB_DIRECT_URI=mongodb://<user>:<password>@shard-00-00.example.mongodb.net:27017,shard-00-01.example.mongodb.net:27017,shard-00-02.example.mongodb.net:27017/seva_pass?authSource=admin&replicaSet=atlas-xxxxxx-shard-0&retryWrites=true&w=majority&tls=true

# ---- Devotee quota ----
# How many non-revoked passes a devotee may hold at once (per-user override via admin).
DEVOTEE_DEFAULT_QUOTA=30

# ---- Main Prasadam Distribution system (HkmVizagTech/QRsystembackend) ----
# Leave unset for standalone mode (this app generates and validates its own QRs).
# When set, issuing a pass claims a QR from the main system by phone, and check-ins
# sync back to it. Requires the endpoints in README "Main-system API contract".
# MAIN_SYSTEM_API_URL=http://localhost:8080
# MAIN_SYSTEM_API_KEY=optional-shared-secret

# ---- WhatsApp Business Cloud API (optional, for future QR delivery) ----
# Get these from https://developers.facebook.com (Meta for Developers > WhatsApp > API Setup)
# WHATSAPP_API_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_BASE_URL=https://graph.facebook.com/v21.0
