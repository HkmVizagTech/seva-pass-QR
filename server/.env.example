# Server port
PORT=4000

# JWT signing secret — use a strong random string in production
JWT_SECRET=change-me-to-a-long-random-string

# MongoDB connection string (MongoDB Atlas)
# Get yours: Atlas > Database > Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/seva_pass?retryWrites=true&w=majority

# Optional fallback: a "direct" connection string (host:port list + replicaSet).
# Use this if the app logs "SRV lookup failed on this machine" (Node's SRV DNS
# resolution can fail on some Windows/machine setups). Find the shard hostnames
# via:  Resolve-DnsName _mongodb._tcp.<cluster>.mongodb.net -Type SRV
# and the replicaSet via:  Resolve-DnsName _mongodb._tcp.<cluster>.mongodb.net -Type TXT
# MONGODB_DIRECT_URI=mongodb://<user>:<password>@shard-00-00.example.mongodb.net:27017,shard-00-01.example.mongodb.net:27017,shard-00-02.example.mongodb.net:27017/seva_pass?authSource=admin&replicaSet=atlas-xxxxxx-shard-0&retryWrites=true&w=majority&tls=true

# ---- Devotee quota ----
# How many non-revoked passes a devotee may hold at once (per-user override via admin).
DEVOTEE_DEFAULT_QUOTA=30

# ---- Main ISKCON Seva Pass system (HkmVizagTech/iskcon-seva-pass-backend) ----
# Leave unset for standalone mode (this app generates and validates its own QRs).
# When set, issuing a pass claims a QR from the main system by the invitee's phone
# via POST /api/integration/generate-volunteer-qr (see README "Main-system API contract").
# MAIN_SYSTEM_API_URL=https://your-main-backend.example.com
# MAIN_SYSTEM_API_KEY=shared-integration-key (the main system's INTEGRATION_API_KEY)
# MAIN_SYSTEM_EVENT_ID=EVT2026 (eventCode of the event in the main system to issue against)

# ---- WhatsApp Business Cloud API (optional, for future QR delivery) ----
# Get these from https://developers.facebook.com (Meta for Developers > WhatsApp > API Setup)
# WHATSAPP_API_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_BASE_URL=https://graph.facebook.com/v21.0

# ---- WhatsApp auto-delivery via Gupshup (auto-send QR on issue) ----
# When enabled + configured, every issued pass is auto-sent to the recipient's
# WhatsApp via Gupshup (template message with the QR image).
# GUPSHUP_ENABLED=true
# GUPSHUP_API_KEY=<Gupshup API key>
# GUPSHUP_SOURCE_NUMBER=<registered WhatsApp number, e.g. 919000000000>
# GUPSHUP_APP_NAME=<app name the source number belongs to>
# GUPSHUP_TEMPLATE_ID=<approved template id with params: name, event, date, venue, help>
# BACKEND_PUBLIC_URL=<public URL of this server, e.g. https://seva-pass-server-production.up.railway.app>
# HELP_CONTACT=<help number shown in the WhatsApp message, e.g. 8977761187>

# ---- Vaikuntham community app sync (harekrishnavizag.co.in) ----
# When enabled, every issued pass is pushed to the Vaikuntham community app so
# it shows up there too. Events must also have a third_party_event_id mapped
# (set in the Events page). The target server allows access by IP whitelist only.
# THIRD_PARTY_SYNC_ENABLED=true
# THIRD_PARTY_API_URL=https://harekrishnavizag.co.in

# ---- WhatsApp webhook verification (Gupshup delivery callbacks) ----
# WEBHOOK_VERIFY_TOKEN=<random string>
