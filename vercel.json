{
  "version": 2,
  "installCommand": "npm install --include=dev",
  "buildCommand": "cd client && npm run build",
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "client/dist/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/((?!api/).*)", "dest": "/client/dist/index.html" }
  ]
}
